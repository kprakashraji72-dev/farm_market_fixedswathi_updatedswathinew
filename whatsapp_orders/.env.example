# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Flow Django Backend (.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-whatsapp-orders-secret-key-local-999
DEBUG=True
ALLOWED_HOSTS=*

# ── Draft-Mode vs. Published-Mode Setting ────────────────────────────────────
# TESTING_MODE controls whether incoming messages trigger live Meta Graph API calls.
#
# TESTING_MODE=true (Draft Mode - RECOMMENDED FOR LOCAL DEVELOPMENT):
#   - WhatsApp unpublished draft flows CANNOT be sent via live Cloud API messages
#     due to Meta integrity restrictions (Error 139000 - Blocked By Integrity).
#   - When set to true, incoming keyword triggers ("hi", "order", etc.) will log:
#       "Draft mode active — trigger flow manually via Preview in WhatsApp Manager"
#     and immediately return HTTP 200 without invoking the Meta Graph API.
#   - Test your entire Flow data exchange via WhatsApp Manager's "Preview Flow" tool,
#     pointing the Endpoint URI to your ngrok tunnel:
#     https://<your-subdomain>.ngrok-free.app/webhook/flow-data-exchange/
#
# TESTING_MODE=false (Published Mode - PRODUCTION):
#   - Once your Flow is verified, approved, and PUBLISHED in Meta WhatsApp Manager,
#     set TESTING_MODE=false.
#   - Incoming keyword messages ("hi") will actively invoke send_flow_trigger_message()
#     to dispatch the live interactive Flow message to the customer's WhatsApp chat.
TESTING_MODE=true

# ── Celery & Redis Configuration ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# ── WhatsApp Cloud API Credentials ───────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_or_temporary_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=fresh_trace_wa_c5a23fd481477ef350e8944373ddfe3a
WHATSAPP_PHONE_NUMBER_ID=1297443690119359
WHATSAPP_WABA_ID=1965689270778996
WHATSAPP_FLOW_ID=1422173683118152
WHATSAPP_FLOW_MODE=draft
WHATSAPP_API_VERSION=v20.0

# ── WhatsApp Flow Cryptography (RSA-2048) ────────────────────────────────────
# Provide either the inline PEM string or path to the private key file
WHATSAPP_FLOW_PRIVATE_KEY_PEM=
WHATSAPP_FLOW_PRIVATE_KEY_PATH=whatsapp_flow_private.pem
