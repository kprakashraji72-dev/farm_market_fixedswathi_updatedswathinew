SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*
PORT=8000

# Database (sqlite for dev, postgres for production)
DB_ENGINE=sqlite
DB_NAME=freshtrace
DB_USER=freshtrace_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# WhatsApp Cloud API & Flow Credentials (wa_flow)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
FLOW_ID=your_meta_flow_id
VERIFY_TOKEN=your_custom_webhook_verify_token
FLOW_MODE=draft

# Draft-Mode vs. Published-Mode (Local testing vs Live production)
# TESTING_MODE=true: suppresses outbound Cloud API messages on "hi" (prevents Error 139000
# on unpublished draft flows) and allows testing via WhatsApp Manager Preview Flow.
# TESTING_MODE=false: enables live outbound Cloud API interactive messages.
TESTING_MODE=true

# Flow Private Key PEM (Paste single line with \n or format as multi-line PEM)
FLOW_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
FLOW_PRIVATE_KEY_PASSPHRASE=
FLOW_PRIVATE_KEY_PATH=whatsapp_flow_private.pem

# Email Configuration (defaults to console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fresh Trace <no-reply@freshtrace.local>
